{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/tmux/scripts/agent-status.sh codex idle",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/tmux/scripts/agent-status.sh codex busy",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/tmux/scripts/agent-status.sh codex done",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/tmux/scripts/agent-status.sh codex perm",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
